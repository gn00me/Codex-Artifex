<section class="shell"><header class="mast"><div class="sigil">✦</div><div><h1>CODEX ARTIFEX</h1><em>Character Chronicle</em></div><img src="{{actor.img}}" data-portrait><label>Name<input data-path="name" value="{{actor.name}}"></label><label>Character Type<select data-path="system.characterType"><option value="mortal" {{#if mortal}}selected{{/if}}>Mortal</option><option value="artifex" {{#if artifex}}selected{{/if}}>Artifex</option><option value="other" {{#if other}}selected{{/if}}>Other</option></select></label></header><div class="book"><nav><button data-tab="character">Character</button><button data-tab="traits">Traits</button>{{#if isArt}}<button data-tab="art">Art</button>{{/if}}<button data-tab="status">Status</button><button data-tab="items">Items</button></nav><main><i class="gutter"></i>
<section class="page" data-page="character"><h2>Character</h2><div class="orn">◆ ───── ◆</div><div class="grid3">{{#if artifex}}<label>Talent<select data-path="system.talent"><option>Artifex Bloodline</option><option>Artifex Gifted</option><option>Artifex Marked</option><option>Sorcerer Bloodline</option><option>Sorcerer Gifted</option><option>Sorcerer Marked</option></select></label>{{/if}}{{#if other}}<label>Other Type<input data-path="system.otherType" value="{{system.otherType}}"></label>{{/if}}<label>Association<select data-path="system.association"><option>None</option><option>Sorcerers</option><option>Gathering</option><option>League of Shadows</option><option>Wild Wand</option></select></label><label>Concept<input data-path="system.concept" value="{{system.concept}}"></label></div><div class="spread"><article><h3>Notes <button data-add="notes">+</button></h3>{{#each notes}}<div class="row"><textarea data-path="system.notes.{{key}}.text">{{text}}</textarea><button class="delete-button" data-remove="system.notes.{{key}}">×</button></div>{{/each}}</article><article><h3>Description & History</h3><label>Description<textarea data-path="system.description">{{system.description}}</textarea></label><label>History<textarea data-path="system.history">{{system.history}}</textarea></label><h3>Development</h3><input type="number" min="0" data-path="system.development" value="{{system.development}}"><h3>Development Log <button data-add="developmentHistory">+</button></h3>{{#each dev}}<div class="row"><textarea data-path="system.developmentHistory.{{key}}.text">{{text}}</textarea><button class="delete-button" data-remove="system.developmentHistory.{{key}}">×</button></div>{{/each}}</article></div></section>
<section class="page" data-page="traits"><h2>Traits</h2><div class="orn">◆ ───── ◆</div><div class="stats">{{#each system.traits as |v k|}}<label><button data-roll="{{k}}">{{k}}</button><input type="number" min="-4" data-path="system.traits.{{k}}" value="{{v}}"></label>{{/each}}</div><article><h3>Trumps <button data-add="trumps">+</button></h3><div class="head traits"><b>Trump</b><b>Trait</b><b>Description</b><b></b></div>{{#each trumps}}<div class="line traits"><input data-path="system.trumps.{{key}}.name" value="{{name}}"><select data-path="system.trumps.{{key}}.trait"><option value="none">None</option><option value="air">Air</option><option value="earth">Earth</option><option value="fire">Fire</option><option value="water">Water</option></select><input data-path="system.trumps.{{key}}.description" value="{{description}}"><button class="delete-button" data-remove="system.trumps.{{key}}">×</button></div>{{/each}}</article><article><h3>Blots <button data-add="blots">+</button></h3><div class="head traits"><b>Blot</b><b>Trait</b><b>Description</b><b></b></div>{{#each blots}}<div class="line traits"><input data-path="system.blots.{{key}}.name" value="{{name}}"><select data-path="system.blots.{{key}}.trait"><option value="none">None</option><option value="air">Air</option><option value="earth">Earth</option><option value="fire">Fire</option><option value="water">Water</option></select><input data-path="system.blots.{{key}}.description" value="{{description}}"><button class="delete-button" data-remove="system.blots.{{key}}">×</button></div>{{/each}}</article></section>
{{#if isArt}}<section class="page" data-page="art"><h2>Art</h2><div class="orn">◆ ───── ◆</div><div class="stats"><label><button data-roll="finesse">Finesse</button><input type="number" min="0" data-path="system.art.finesse" value="{{system.art.finesse}}"></label><label><button data-roll="power">Power</button><input type="number" min="0" data-path="system.art.power" value="{{system.art.power}}"></label><label>Vitalis Vis<input type="number" data-path="system.art.vitalis" value="{{system.art.vitalis}}"><b>/ {{vmax}}</b><button data-restore>Restore Vitalis Vis</button></label><label>Vanitas<input type="number" data-path="system.art.vanitas" value="{{system.art.vanitas}}"><button data-discharge>Discharge Vanitas</button></label></div>{{#if artifex}}<article><h3>Coniunctis</h3><label>Name<input data-path="system.art.coniunctis.name" value="{{system.art.coniunctis.name}}"></label><label>Description<textarea data-path="system.art.coniunctis.description">{{system.art.coniunctis.description}}</textarea></label><label>Available<input type="checkbox" data-path="system.art.coniunctis.available" {{checked system.art.coniunctis.available}}></label></article>{{/if}}<article><h3>Art Trumps <button data-add="art.trumps">+</button></h3>{{#each artTrumps}}<div class="row"><input data-path="system.art.trumps.{{key}}.name" value="{{name}}"><input data-path="system.art.trumps.{{key}}.description" value="{{description}}"><button class="delete-button" data-remove="system.art.trumps.{{key}}">×</button></div>{{/each}}</article><article><h3>Art Blots <button data-add="art.blots">+</button></h3>{{#each artBlots}}<div class="row"><input data-path="system.art.blots.{{key}}.name" value="{{name}}"><input data-path="system.art.blots.{{key}}.description" value="{{description}}"><button class="delete-button" data-remove="system.art.blots.{{key}}">×</button></div>{{/each}}</article></section>{{/if}}
<section class="page" data-page="status"><h2>Status</h2><div class="orn">◆ ───── ◆</div><div class="spread status-spread"><article class="status-panel"><h3>Health</h3><div class="status-table-head"><b>Damage</b><b>Health</b></div>{{#each health}}<div class="track"><div class="track-damage">{{#each damage}}<label class="box"><input type="checkbox" data-damage="health" data-row="{{../key}}" data-i="{{i}}" {{checked on}}><i></i></label>{{/each}}</div><label class="box state-box"><input type="checkbox" data-path="system.health.{{key}}.state" {{checked state}}><i></i></label></div>{{/each}}<div class="status-actions"><button data-clear-damage="health">Clear Damage</button><button data-clear-state="health">Clear Health</button></div></article><article class="status-panel"><h3>Psyche</h3><div class="status-table-head"><b>Damage</b><b>Psyche</b></div>{{#each psyche}}<div class="track"><div class="track-damage">{{#each damage}}<label class="box"><input type="checkbox" data-damage="psyche" data-row="{{../key}}" data-i="{{i}}" {{checked on}}><i></i></label>{{/each}}</div><label class="box state-box"><input type="checkbox" data-path="system.psyche.{{key}}.state" {{checked state}}><i></i></label></div>{{/each}}<div class="status-actions"><button data-clear-damage="psyche">Clear Damage</button><button data-clear-state="psyche">Clear Psyche</button></div></article></div></section>
<section class="page" data-page="items"><h2>Items</h2><div class="orn">◆ ───── ◆</div><article><h3>Weapons <button class="add-button" data-add="weapons">+</button></h3><div class="item-head"><b>Name</b><b>Type</b><b>Value</b><b>Overload</b><b>Notes</b><b></b></div>{{#each weapons}}<div class="item-row"><input data-path="system.weapons.{{key}}.name" value="{{name}}"><select data-path="system.weapons.{{key}}.type" data-gear="weapon" data-value="system.weapons.{{key}}.value"><option value="light" {{#if light}}selected{{/if}}>Light</option><option value="medium" {{#if medium}}selected{{/if}}>Medium</option><option value="heavy" {{#if heavy}}selected{{/if}}>Heavy</option><option value="veryHeavy" {{#if veryHeavy}}selected{{/if}}>Very Heavy</option></select><input type="number" value="{{value}}" readonly><label class="box overload-box"><input type="checkbox" data-path="system.weapons.{{key}}.overload" {{checked overload}}><i></i></label><input data-path="system.weapons.{{key}}.notes" value="{{notes}}"><button class="delete-button" data-remove="system.weapons.{{key}}">×</button></div>{{/each}}</article><article><h3>Armors <button class="add-button" data-add="armors">+</button></h3><div class="item-head"><b>Name</b><b>Type</b><b>Value</b><b>Overload</b><b>Notes</b><b></b></div>{{#each armors}}<div class="item-row"><input data-path="system.armors.{{key}}.name" value="{{name}}"><select data-path="system.armors.{{key}}.type" data-gear="armor" data-value="system.armors.{{key}}.value"><option value="light" {{#if light}}selected{{/if}}>Light</option><option value="medium" {{#if medium}}selected{{/if}}>Medium</option><option value="heavy" {{#if heavy}}selected{{/if}}>Heavy</option><option value="veryHeavy" {{#if veryHeavy}}selected{{/if}}>Very Heavy</option></select><input type="number" value="{{value}}" readonly><label class="box overload-box"><input type="checkbox" data-path="system.armors.{{key}}.overload" {{checked overload}}><i></i></label><input data-path="system.armors.{{key}}.notes" value="{{notes}}"><button class="delete-button" data-remove="system.armors.{{key}}">×</button></div>{{/each}}</article><article><h3>Equipment <button class="add-button" data-add="equipment">+</button></h3><div class="equipment-head"><b>Equipment</b><b></b></div>{{#each equipment}}<div class="equipment-row"><input data-path="system.equipment.{{key}}.name" value="{{name}}"><button class="delete-button" data-remove="system.equipment.{{key}}">×</button></div>{{/each}}</article></section>
</main></div></section>
